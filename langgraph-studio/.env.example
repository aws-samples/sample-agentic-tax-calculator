# AWS region for Bedrock model access
AWS_REGION=us-west-2

# Bedrock model - pick ONE of these formats depending on your account setup:
#
# Option 1: Standard model ID (works in most accounts)
TAX_CALC_LLM_MODEL_ID=anthropic.claude-sonnet-4-6-20250514
#
# Option 2: Cross-region inference profile ID (if enabled in your account)
# TAX_CALC_LLM_MODEL_ID=us.anthropic.claude-sonnet-4-6
#
# Option 3: Full inference profile ARN (if you have a custom profile)
# TAX_CALC_LLM_MODEL_ID=arn:aws:bedrock:us-west-2:123456789012:inference-profile/us.anthropic.claude-sonnet-4-6
