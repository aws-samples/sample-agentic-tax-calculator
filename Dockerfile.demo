FROM python:3.11-slim

WORKDIR /app

# Install runtime + demo dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt streamlit

# Copy application code
COPY src/ src/
COPY demo_ui.py .

# Streamlit config: disable telemetry, set server defaults
RUN mkdir -p /root/.streamlit
RUN echo '[server]\nheadless = true\nport = 8501\naddress = "0.0.0.0"\nenableCORS = false\n\n[browser]\ngatherUsageStats = false' > /root/.streamlit/config.toml

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8501/_stcore/health')" || exit 1

CMD ["streamlit", "run", "demo_ui.py"]
